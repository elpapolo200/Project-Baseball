+                 * puntero. FN_TEST evita duplicados al sacar la semilla. */
+                {
+                    sq_push(q, t, ARM_T32, 1);
+                    r->seeds_shape++;  /* contamos como shape para estad├¡sticas */
+                    found++;
+                }
+            }
+            off += (run - 1) * 2;  /* saltar el resto del run */
+        }
+    }
+    return found;
