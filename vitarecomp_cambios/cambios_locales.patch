+        uint32_t run = 1;
+        /* `run` cuenta instrucciones, y cada una ocupa 2 bytes. Medirlo en
+         * bytes le├¡a 0x7047 (la mitad de un bx lr y la de otro): el run
+         * siempre val├¡a 1 y este barrido no sembraba nada. */
+        while (off + run * 2 + 2 <= len) {
